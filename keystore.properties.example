# Copier vers keystore.properties et compléter.
# Sans ce fichier, `assembleRelease` signe avec la clé de debug : l'APK
# s'installe mais ne se publie pas.
#
# keytool -genkeypair -v -keystore astra.jks -keyalg RSA -keysize 2048 \
#         -validity 10000 -alias astra
storeFile=astra.jks
storePassword=
keyAlias=astra
keyPassword=
